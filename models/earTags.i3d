<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="earTags.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="CowBreedsRLRM blender/build_eartags.py" version="1"/>
  </Asset>

  <Files>
    <File fileId="1" filename="earTagPlastic_diffuse.dds"/>
    <File fileId="2" filename="colourShader.xml"/>
    <File fileId="3" filename="earTagGlyphs_diffuse.dds"/>
    <File fileId="4" filename="offsetUV.xml"/>
  </Files>

  <Materials>
    <Material name="earTag_mat" materialId="1" specularColor="0.45 1 0" customShaderId="2">
      <Texture fileId="1"/>
      <CustomParameter name="colorScale" value="0.8 0.68 0.02"/>
    </Material>
    <Material name="earTagCap_mat" materialId="2" specularColor="0.7 1 0" customShaderId="2">
      <Texture fileId="1"/>
      <CustomParameter name="colorScale" value="0.02 0.02 0.02"/>
    </Material>
    <Material name="earTagPrint_mat" materialId="3" specularColor="0.45 1 0" customShaderId="4">
      <Texture fileId="3"/>
      <CustomParameter name="playScale" value="0 0 16 8"/>
      <CustomParameter name="colorScale" value="0 0 0"/>
    </Material>
  </Materials>

  <Shapes externalShapesFile="earTags.i3d.shapes">
  </Shapes>

